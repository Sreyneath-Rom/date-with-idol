{
  "entities": {
    "user": {
      "title": "User",
      "description": "Represents the player profile in the game",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the player"
        },
        "selectedIdolId": {
          "type": "string",
          "description": "The ID of the currently selected K-pop idol"
        },
        "affection": {
          "type": "integer",
          "description": "The current affection level of the player with the selected idol"
        }
      },
      "required": [
        "name",
        "selectedIdolId",
        "affection"
      ]
    },
    "chat_message": {
      "title": "Chat Message",
      "description": "A single text, voice, or image chat message",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "sender": {
          "type": "string",
          "enum": [
            "player"
          ]
        },
        "text": {
          "type": "string"
        },
        "timestamp": {
          "type": "integer"
        },
        "type": {
          "type": "string",
          "enum": [
            "text",
            "voice",
            "image"
          ]
        },
        "imageUrl": {
          "type": "string"
        },
        "audioUrl": {
          "type": "string"
        },
        "audioDuration": {
          "type": "integer"
        },
        "reaction": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "sender",
        "text",
        "timestamp",
        "type"
      ]
    },
    "status_update": {
      "title": "Status Update",
      "description": "A historical status update or story posted by an idol",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "timestamp": {
          "type": "integer"
        },
        "imageUrl": {
          "type": "string"
        },
        "likes": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "text",
        "timestamp"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User profile document"
    },
    "/users/{userId}/chats/{idolId}/messages/{messageId}": {
      "schema": "chat_message",
      "description": "Message log in the chat room with a specific idol"
    },
    "/idols/{idolId}/status_updates/{updateId}": {
      "schema": "status_update",
      "description": "A list of past status updates or thoughts from an idol"
    }
  }
}
